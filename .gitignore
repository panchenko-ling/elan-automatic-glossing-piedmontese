# --- Corpus data (not redistributable) ---
# ELAN transcription files and lexicon are fieldwork data under consent
# agreements. Keep them out of the repo.
*.eaf
*.pfsx
*.etf
Lexicon-*

# Allow the small demo files that ARE safe to publish
!data/sample/*.eaf

# Pipeline outputs
*_step[0-9].eaf
*_automatic.eaf
*_upd.eaf
*_clean.eaf
word_morph_gloss_dict_upd.json

# Media
*.wav
*.mp3
*.mp4
*.mov

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
